{
  "input_window": 12,
  "output_window": 12,
  "hidden_dim": 128,
  "num_heads": 4,
  "encoder_layers": 2,
  "decoder_layers": 2,
  "ffn_hidden_dim": 512,
  "graph_k_hop": 1,
  "use_fuzzy_graph": true,
  "fuzzy_num_sets": 3,
  "use_cell_attention": true,
  "num_cells": 16,
  "use_hollow_kernel": true,
  "cell_blend_init": 0.4,
  "use_spatiotemporal_attention": true,
  "use_temporal_position_embedding": true,
  "use_proto_adaptive_embed": true,
  "use_gradient_checkpointing": false,
  "use_amp": true,
  "dropout": 0.1,
  "graph_closure_steps": 0,
  "conservation_loss_weight": 0.05,
  "conservation_warmup_epochs": 15,
  "conservation_steps_per_epoch": 240,
  "physics_channel_idx": 0,
  "use_fuzzy_conservation": true,
  "scaler": "standard",
  "load_external": false,
  "normal_external": false,
  "add_time_in_day": true,
  "add_day_in_week": true,
  "max_epoch": 100,
  "scale_lr": false,
  "learner": "adam",
  "learning_rate": 0.001,
  "lr_scheduler": "cosineannealinglr",
  "weight_decay": 0.0001,
  "clip_grad_norm": true,
  "max_grad_norm": 3,
  "use_early_stop": true,
  "patience": 30,
  "batch_size": 64,
  "eval_batch_size": 64,
  "graph_topk": 32,
  "use_torch_compile": true,
  "t2_lr_boost": 1.0,
  "beta_init_random": false,
  "t2_entropy_weight": 0.002,
  "t2_interval_weight": 0.005,
  "t2_fou_floor_weight": 0.01,
  "t2_interval_ratio_threshold": 0.9,
  "proto_norm_reg_weight": 0.01,
  "latent_norm_reg_weight": 0.01,
  "graph_sparsify_topk": 0,
  "data_col": ["traffic_flow"],
  "output_dim": 1,
  "lr_T_max": 100,
  "lr_eta_min": 1e-6
}
