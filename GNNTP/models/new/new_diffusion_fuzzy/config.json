{
  "input_window": 12,
  "output_window": 12,
  "hidden_dim": 96,
  "num_heads": 4,
  "encoder_layers": 2,
  "denoiser_layers": 3,
  "ffn_hidden_dim": 192,
  "graph_k_hop": 2,
  "use_adaptive_graph": true,
  "adaptive_graph_embed_dim": 32,
  "adaptive_graph_topk": 12,
  "adaptive_graph_blend_init": 0.5,
  "use_fuzzy_graph": true,
  "fuzzy_graph_num_sets": 3,
  "fuzzy_graph_sigma_init": 0.7,
  "use_spatiotemporal_attention": true,
  "use_temporal_position_embedding": true,
  "use_gradient_checkpointing": false,
  "use_amp": false,
  "dropout": 0.1,
  "diffusion_steps": 200,
  "diffusion_schedule": "linear",
  "beta_start": 0.0001,
  "beta_end": 0.02,
  "num_sampling_steps": 50,
  "num_prediction_samples": 2,
  "sampling_method": "ddim",
  "ddim_eta": 0.0,
  "physics_loss_weight": 0.0,
  "physics_warmup_steps": 3000,
  "physics_warmup_start_ratio": 0.2,
  "physics_warmup_mode": "linear",
  "flow_conservation_coeff": 1.0,
  "physics_channel_idx": 0,
  "use_fuzzy_conservation": true,
  "fuzzy_conservation_threshold": 0.6,
  "fuzzy_conservation_temperature": 8.0,
  "scaler": "standard",
  "load_external": false,
  "normal_external": false,
  "add_time_in_day": true,
  "add_day_in_week": true,
  "max_epoch": 100,
  "scale_lr": false,
  "learner": "adamw",
  "learning_rate": 0.001,
  "lr_decay": true,
  "lr_scheduler": "cosineannealinglr",
  "lr_T_max": 100,
  "lr_eta_min": 0.00001,
  "weight_decay": 0.0001,
  "clip_grad_norm": true,
  "max_grad_norm": 3,
  "use_early_stop": true,
  "patience": 30,
  "batch_size": 32,
  "eval_batch_size": 32
}
