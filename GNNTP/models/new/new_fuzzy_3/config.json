{
  "input_window": 12,
  "output_window": 12,
  "hidden_dim": 64,
  "num_heads": 2,
  "encoder_layers": 2,
  "decoder_layers": 2,
  "ffn_hidden_dim": 128,
  "graph_k_hop": 2,
  "use_fuzzy_graph": true,
  "fuzzy_num_sets": 3,
  "use_spatiotemporal_attention": true,
  "use_temporal_position_embedding": true,
  "use_gradient_checkpointing": false,
  "use_amp": true,
  "amp_dtype": "bfloat16",
  "dropout": 0.1,
  "use_diffusion": true,
  "diffusion_steps": 50,
  "diffusion_schedule": "linear",
  "beta_start": 0.0001,
  "beta_end": 0.01,
  "num_sampling_steps": 20,
  "ddim_eta": 0.0,
  "denoiser_layers": 2,
  "prediction_clamp_min": -3.0,
  "prediction_clamp_max": 3.0,
  "conservation_loss_weight": 0.1,
